{
  "name": "pharmalink-analyzer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" --kill-others",
    "dev:backend": "cd src-backend && uv run uvicorn app.main:app --port 8765 --reload",
    "dev:frontend": "cd src-frontend && npx vite",
    "build:frontend": "cd src-frontend && npx vue-tsc --noEmit && npx vite build",
    "build:backend": "bash scripts/build-backend.sh",
    "tauri:dev": "WEBKIT_DISABLE_DMABUF_RENDERER=1 cargo tauri dev",
    "tauri:build": "npm run build:backend && cargo tauri build",
    "test:tauri": "bash tests/test-tauri-gui.sh",
    "start": "bash scripts/start.sh"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.1",
    "beautiful-mermaid": "^1.1.3",
    "concurrently": "^9.1"
  }
}
