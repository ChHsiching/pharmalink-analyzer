{
  "name": "pharmalink-analyzer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" --kill-others",
    "dev:backend": "cd src-backend && uv run uvicorn app.main:app --port 8765 --reload",
    "dev:frontend": "cd src-frontend && npx vite",
    "build:frontend": "cd src-frontend && npx vue-tsc --noEmit && npx vite build",
    "tauri:dev": "cargo tauri dev",
    "tauri:build": "cargo tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.1",
    "concurrently": "^9.1"
  }
}
